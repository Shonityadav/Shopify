{% if shop.metafields.vip.pass_variant_id.value != blank %}
<script>

  const VIP_ID = {{ shop.metafields.vip.pass_variant_id.value | split: '/' | last | default: 0 }};
  const GIFT_ID = {{ shop.metafields.gift.gift_variant_id.value | split: '/' | last | default: 0 }};
document.addEventListener("DOMContentLoaded", async function(){

console.log("[VIP DEBUG] Script Loaded");

console.log("[VIP DEBUG] VIP Variant ID:", VIP_ID);
console.log("[VIP DEBUG] Gift Variant ID:", GIFT_ID);

/* ==============================
   GET CART
============================== */

async function getCart(){
  return await fetch('/cart.js').then(res => res.json());
}

/* ==============================
   VIP CART RULE ENFORCER
============================== */
let isProcessingCart = false;

window.enforceVipGiftRules = async function(cart){

  if (isProcessingCart) return false;

  if (!GIFT_ID || GIFT_ID == 0) {
    console.log("❌ No ACTIVE gift configured");
    return false;
  }

  /* ==============================
     DETECT ITEMS
  ============================== */

  const vipItems = cart.items.filter(i => 
    i.product_type === "vip_membership" ||
    (i.product_title && i.product_title.toLowerCase().includes("vip")) ||
    i.properties?._vip === "true"
  );

  const giftItems = cart.items.filter(i => 
    i.properties?._gift === "true"
  );

  const activeVipInCart = cart.items.find(i => i.variant_id == VIP_ID);
  const activeGiftInCart = cart.items.find(i => i.variant_id == GIFT_ID);

  const userRemovedVip = cart.attributes?.vip_removed === "true";

  /* ==============================
     REMOVE WRONG VIP PASSES
  ============================== */

  for (const item of vipItems) {

    if (item.variant_id != VIP_ID) {

      console.log("🧹 Removing old VIP:", item.variant_id);

      isProcessingCart = true;

      await fetch('/cart/change.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          id: item.key,
          quantity: 0
        })
      });

      isProcessingCart = false;
      window.location.reload();

      return true;
    }
  }

  /* ==============================
     REMOVE WRONG GIFTS
  ============================== */

  for (const item of giftItems) {

    if (item.variant_id != GIFT_ID) {

      console.log("🧹 Removing old gift:", item.variant_id);

      isProcessingCart = true;

      await fetch('/cart/change.js',{
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body: JSON.stringify({
          id: item.key,
          quantity: 0
        })
      });

      isProcessingCart = false;
      window.location.reload();

      return true;
    }
  }

  /* ==============================
     REMOVE GIFT IF VIP REMOVED (🔥 FIXED)
  ============================== */

  if(vipItems.length === 0 && giftItems.length > 0){

    console.log("🧹 Removing gifts (VIP removed)");

    isProcessingCart = true;

    for (const item of giftItems) {

      await fetch('/cart/change.js',{
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body: JSON.stringify({
          id: item.key,
          quantity: 0
        })
      });

    }

    isProcessingCart = false;
    window.location.reload();

    return true;
  }

  /* ==============================
     FIX VIP QUANTITY
  ============================== */

  if(activeVipInCart && activeVipInCart.quantity > 1){

    console.log("[VIP DEBUG] Fixing VIP quantity");

    isProcessingCart = true;

    await fetch('/cart/change.js',{
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({
        id: activeVipInCart.key,
        quantity: 1
      })
    });

    isProcessingCart = false;
    window.location.reload();
    return true;
  }

  /* ==============================
     FIX GIFT QUANTITY
  ============================== */

  if(activeGiftInCart && activeGiftInCart.quantity > 1){

    console.log("[VIP DEBUG] Fixing gift quantity");

    isProcessingCart = true;

    await fetch('/cart/change.js',{
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({
        id: activeGiftInCart.key,
        quantity: 1
      })
    });

    isProcessingCart = false;
    window.location.reload();
    return true;
  }

  /* ==============================
     DETECT MANUAL VIP REMOVAL
  ============================== */

  if (!vipItems.length && VIP_ID && !userRemovedVip) {

    console.log("👤 VIP removed manually → setting flag");

    isProcessingCart = true;

    await fetch('/cart/update.js', {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({
        attributes: {
          vip_removed: "true"
        }
      })
    });

    isProcessingCart = false;
    window.location.reload();

    return true;
  }

  /* ==============================
     ADD ACTIVE VIP IF MISSING
  ============================== */

  if (!activeVipInCart && VIP_ID && VIP_ID != 0 && !userRemovedVip) {

    console.log("👑 Adding active VIP:", VIP_ID);

    isProcessingCart = true;

    await fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        items: [{
          id: Number(VIP_ID),
          quantity: 1,
          properties: {
            _vip: "true"
          }
        }]
      })
    });

    await fetch('/cart/update.js', {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({
        attributes: {
          vip_removed: ""
        }
      })
    });

    isProcessingCart = false;
    window.location.reload();

    return true;
  }

  /* ==============================
     ADD ACTIVE GIFT
  ============================== */

  if(activeVipInCart && !activeGiftInCart){

    console.log("🎁 Adding active gift:", GIFT_ID);

    isProcessingCart = true;

    await fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        items: [{
          id: Number(GIFT_ID),
          quantity: 1,
          properties: {
            _gift: "true"
          }
        }]
      })
    });

    isProcessingCart = false;
    window.location.reload();

    return true;
  }

  return false;
};

const originalFetch = window.fetch;

window.fetch = async (...args) => {

  const url = args[0]?.toString() || "";

  const isCartApi =
    url.includes("/cart/add") ||
    url.includes("/cart/change") ||
    url.includes("/cart/update") ||
    url.includes("/cart/clear");

  const res = await originalFetch(...args);

  if (isCartApi) {

    console.log("[VIP DEBUG] Cart API detected:", url);

    try {
      const cartRes = await originalFetch('/cart.js');
      const cart = await cartRes.json();

      const shouldRerun = await window.enforceVipGiftRules(cart);

      if (shouldRerun) {
        console.log("[VIP DEBUG] Re-running rules...");
      }

      // 🔥 THIS WAS MISSING → UI refresh
      document.dispatchEvent(new CustomEvent('cart:refresh'));

    } catch (err) {
      console.error("Cart sync error:", err);
    }
  }

  return res;
};
/* ==============================
   GENERATE COUPONS
============================== */

function generateCoupons(){

  const coupons = [];

  for(let i=0;i<3;i++){

    const code = "VIP-" + Math.random().toString(36).substring(2,10).toUpperCase();

    coupons.push(code);

    console.log("[VIP DEBUG] Generated coupon:", code);

  }

  localStorage.setItem("vip_coupons", JSON.stringify(coupons));

  return coupons;
}

/* ==============================
   ATTACH COUPONS TO CART
============================== */

async function attachCouponsToCart(coupons){

  console.log("[VIP DEBUG] Attaching coupons to cart attributes");

  await fetch('/cart/update.js',{
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body: JSON.stringify({
      attributes:{
        vip_coupons: JSON.stringify(coupons)
      }
    })
  });

}

/* ==============================
   APPLY COUPON
============================== */

function applyCoupon(code){

  

  console.log("[VIP DEBUG] Applying coupon:", code);

  sessionStorage.setItem("vip_coupon_applied","true");

  window.location.href = `/discount/${code}?redirect=/cart`;
}

/* ==============================
   COUPON HANDLER
============================== */

async function handleVipCoupons(cart){

  console.log("[VIP DEBUG] ----- COUPON HANDLER START -----");

  console.log("[VIP DEBUG] Cart discounts:", cart.cart_level_discount_applications);

  console.log("[VIP DEBUG] Cart attributes:", cart.attributes);

  console.log("[VIP DEBUG] sessionStorage flag:",
    sessionStorage.getItem("vip_coupon_applied")
  );

  console.log("[VIP DEBUG] localStorage coupons:",
    localStorage.getItem("vip_coupons")
  );

  /* detect real discount */

  const discountApplied =
    cart.cart_level_discount_applications &&
    cart.cart_level_discount_applications.length > 0;

  console.log("[VIP DEBUG] discountApplied:", discountApplied);

  if(discountApplied){

    console.log("[VIP DEBUG] Real discount detected in cart → stopping");

    return;

  }

  let coupons = JSON.parse(localStorage.getItem("vip_coupons"));

  if(!coupons){

    console.log("[VIP DEBUG] No coupons found → generating");

    coupons = generateCoupons();

    await attachCouponsToCart(coupons);

  } else {

    console.log("[VIP DEBUG] Existing coupons found:", coupons);

  }

  console.log("[VIP DEBUG] Attempting to apply coupon:", coupons[0]);

  const couponAttempted = cart.attributes?.vip_coupon_attempted === "true";

  console.log("[VIP DEBUG] couponAttempted:", couponAttempted);

  if(couponAttempted){

    console.log("[VIP DEBUG] Coupon already attempted → stopping loop");

    return;

  }

  console.log("[VIP DEBUG] Attempting to apply coupon:", coupons[0]);

  /* mark attempt */

  await fetch('/cart/update.js',{
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body: JSON.stringify({
      attributes:{
        vip_coupon_attempted: "true"
      }
    })
  });

  window.location.href = `/discount/${coupons[0]}?redirect=/cart`;

}

/* ==============================
   ADD-TO-CART INTERCEPTOR
============================== */
document.addEventListener("submit", async function(e){

  const form = e.target;

  if(form.dataset.vipHandled) return;
  form.dataset.vipHandled = "true";

  const isCartForm =
    form.matches('form[action*="/cart/add"]') ||
    form.classList.contains('product-form');

  if (!isCartForm) return;

  const selectedType = document.querySelector('input[name="purchase_type"]:checked')?.value;

  const subscribeChecked = document.querySelector('input[name="purchase_option"][value="subscribe"]')?.checked;

  const mainVariant = form.querySelector('[name="id"]').value;

  const sellingPlanInput = document.querySelector('input[name="selling_plan"]');
  const subscribeCheckbox = document.querySelector('input[name="purchase_option"][value="subscribe"]');

  let sellingPlanId = sellingPlanInput?.value || null;






  /* if no active plan → disable subscription */
  if (!sellingPlanId) {
    console.log("[VIP DEBUG] No active selling plan → subscription disabled");
  }

  const isVipPurchase = selectedType === "vip";
  /* If subscribe is checked ensure selling plan exists */
  if (isVipPurchase) {
    sellingPlanId = null;
    console.log("[VIP DEBUG] VIP selected → forcing no subscription");
  } else if (subscribeCheckbox?.checked) {
    sellingPlanId = "{{ shop.metafields['app--326294798337--vip'].subscribe_plan_id.value | split: '/' | last }}";
  }

  console.log("[VIP DEBUG] Final sellingPlanId:", sellingPlanId);

  /* If NOT VIP → allow normal Shopify flow */


if (isVipPurchase) {
  console.log("[VIP DEBUG] VIP purchase detected");
}
  

  if(isVipPurchase || sellingPlanId){
    e.preventDefault();
    e.stopImmediatePropagation();
  }

  const items = [];

 

  /* ==============================
   SMART PRODUCT HANDLING
  ============================== */

  const cart = await fetch('/cart.js').then(r => r.json());

  const existingItem = cart.items.find(
    (i) => i.variant_id == mainVariant
  );

  if (existingItem) {

    console.log("[VIP DEBUG] Product already in cart");

    // -----------------------------
    // CASE: SUBSCRIPTION SELECTED
    // -----------------------------
    if (sellingPlanId) {

      console.log("[VIP DEBUG] Converting to subscription");

      await fetch('/cart/change.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          id: existingItem.key,
          quantity: 1,
          selling_plan: sellingPlanId
        })
      });

    } else {

      console.log("[VIP DEBUG] Keeping existing product (no duplicate)");

    }

  } else {

    console.log("[VIP DEBUG] Adding new product");

    if (sellingPlanId) {

      items.push({
        id: mainVariant,
        quantity: 1,
        selling_plan: sellingPlanId
      });

    } else {

      items.push({
        id: mainVariant,
        quantity: 1
      });

    }

  }
  


  /* CHECK CART FIRST */

  

  const vipExists = cart.items.some(i => i.variant_id == VIP_ID);

  /* VIP PASS */

  if(isVipPurchase && !vipExists){

    console.log("[VIP DEBUG] Adding VIP pass");

    items.push({
      id: VIP_ID,
      quantity: 1
    });



  }else{

    console.log("[VIP DEBUG] VIP already exists → skipping");

  }

  /* GIFT PRODUCT */


  await fetch('/cart/add.js',{
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body: JSON.stringify({ items })
  });

  window.location.replace("/cart");

}, true);

/* ==============================
   MAIN EXECUTION FLOW
============================== */

let cart = await getCart();

const changed = await enforceVipGiftRules(cart);

if(changed){

  console.log("[VIP DEBUG] Cart corrected → reloading once");

  location.reload();
  return;
}

const vipItem = cart.items.find(i => i.variant_id == VIP_ID);

if(vipItem){

  console.log("[VIP DEBUG] VIP detected → handling coupons");

  await handleVipCoupons(cart);

}

/* ==============================
   CLEAR COUPONS IF CART EMPTY
============================== */

if(cart.item_count === 0){

  console.log("[VIP DEBUG] Cart empty → clearing coupons");

  localStorage.removeItem("vip_coupons");
  sessionStorage.removeItem("vip_coupon_applied");

}

});

document.addEventListener("DOMContentLoaded", () => {

  console.log("[VIP DEBUG] Removing Shopify native purchase options");

  document.querySelectorAll(`
    .shopify-payment-terms,
    .product-form__selling-plan-group,
    .product__selling-plan-group,
    .selling-plan-group,
    [data-product-purchase-options],
    [data-selling-plan-group]
  `).forEach(el => {
  el.style.display = "none"; // ✅ hide, DON'T remove
});

});
(function(){

  console.log("[VIP DEBUG] Cart API watcher loaded");

  const originalFetch = window.fetch;

  window.fetch = async function(...args){

    const response = await originalFetch.apply(this, args);

    try{

      const url = args[0];

      const CART_ENDPOINTS = [
        "/cart/add",
        "/cart/change",
        "/cart/update",
        "/cart/clear"
      ];

      if(typeof url === "string" && CART_ENDPOINTS.some(e => url.includes(e))){

        console.log("[VIP DEBUG] Cart API detected:", url);

        const cart = await fetch('/cart.js').then(r => r.json());

        const changed = await window.enforceVipGiftRules(cart);

        console.log("[VIP DEBUG] enforceVipGiftRules result:", changed);

      }

    }catch(e){
      console.log("[VIP DEBUG] Cart watcher error:", e);
    }

    return response;

  };

})();
</script>

<script>
  document.addEventListener("DOMContentLoaded", function(){

    const VIP_ID = {{ shop.metafields.vip.pass_variant_id.value | split: '/' | last | default: 0 }};
    const GIFT_ID = {{ shop.metafields.gift.gift_variant_id.value | split: '/' | last | default: 0 }};

    console.log("[VIP DEBUG] Locking quantity controls");

    document.querySelectorAll('[data-quantity-variant-id]').forEach(input => {

      const variantId = input.dataset.quantityVariantId;

      if(variantId == VIP_ID || variantId == GIFT_ID){

        console.log("[VIP DEBUG] Locking quantity for:", variantId);

        /* Force quantity */

        input.value = 1;

        /* Disable typing */

        input.setAttribute("readonly", true);

        const wrapper = input.closest(".quantity");

        if(!wrapper) return;

        /* Disable + and - buttons */

        const buttons = wrapper.querySelectorAll(".quantity__button");

        buttons.forEach(btn => {

          btn.style.pointerEvents = "none";
          btn.style.opacity = "0.4";

        });

      }

    });

  });

 


</script>
