{% assign subscribe_plan = shop.metafields['app--326294798337--vip'].subscribe_plan_id.value %}

{% if template.name == 'product' %}

{% assign base_price = product.selected_or_first_available_variant.price %}
{% assign subscribe_price = base_price | times: 0.8 %}
{% assign vip_discount = shop.metafields.vip.discount_percentage.value | default: 50 %}
{% assign vip_multiplier = 100 | minus: vip_discount | divided_by: 100.0 %}
{% assign vip_price = base_price | times: vip_multiplier %}
{% assign is_vip = customer.metafields.vip.is_vip.value %}

<div class="vip-purchase-options">

<!-- Main Purchase Type (Radio Buttons - mutually exclusive) -->
<fieldset class="product-form__input main-options">
<legend class="form__label">Choose Purchase Type</legend>

<label class="vip-option{% if is_vip == true or is_vip == "true" %} vip-active-option{% endif %}">
  <input type="radio" name="purchase_type" value="regular" checked>

  <div class="vip-option-content">
    <div class="vip-option-title">
      Buy one time
      {% if is_vip == true or is_vip == "true" %}
        <span class="vip-member-badge">&#9733; VIP Price</span>
      {% endif %}
    </div>
  </div>

  <div class="vip-option-price">
    {% if is_vip == true or is_vip == "true" %}
      <span class="vip-original-price">{{ base_price | money }}</span>
      <span class="vip-discounted-price">{{ vip_price | money }}</span>
    {% else %}
      {{ base_price | money }}
    {% endif %}
  </div>
</label>

{% unless is_vip == true or is_vip == "true" %}

<label class="vip-option">
  <input type="radio" name="purchase_type" value="vip">

  <div class="vip-option-content">
    <div class="vip-option-title">VIP Club Membership</div>

    <div class="vip-option-desc">
      ✓ Free SCI Travel Packs<br>
      ✓ Easily edit, skip or cancel anytime<br>
      ✓ 0-Day Money Back Guarantee
    </div>
  </div>

  <div class="vip-option-price">
    {{ vip_price | money }}
  </div>
</label>
{% endunless %}

</fieldset>

{% if subscribe_plan != blank %}
<!-- Subscription Option (Checkbox - can combine with above) -->
<fieldset class="product-form__input subscription-option">


<label class="vip-option subscribe-option">
  <input type="checkbox" name="purchase_option" value="subscribe">

  <div class="vip-option-content">
    <div class="vip-option-title">Subscribe and Save</div>

    <div class="vip-option-desc">
      ✓ Free SCI Travel Packs<br>
      ✓ Easily edit, skip or cancel anytime<br>
      ✓ 0-Day Money Back Guarantee<br>
      {% comment %} <small style="color:#888;">Add to your purchase type above for 20% savings</small> {% endcomment %}
    </div>
  </div>

  <div class="vip-option-price">
    {% comment %} <span class="subscribe-discount">20% OFF</span> {% endcomment %}
  </div>
</label>

</fieldset>
{% endif %}
</div>


<style>

  







.vip-purchase-options{
margin-top:20px;
}

.main-options {
  margin-bottom: 20px;
  padding-bottom: 20px;
  border-bottom: 1px solid #e5e5e5;
}

.subscription-option legend {
  color: #39c6c6;
  font-weight: 600;
}

.vip-option{
display:flex;
align-items:flex-start;
gap:15px;
border:1px solid #e5e5e5;
border-radius:12px;
padding:16px;
margin-bottom:12px;
cursor:pointer;
transition: all 0.2s ease;
}

.vip-option input{
margin-top:4px;
}

.vip-option-content{
flex:1;
}

.vip-option-title{
font-weight:600;
margin-bottom:4px;
}

.vip-option-desc{
font-size:13px;
color:#666;
}

.vip-option-price{
font-weight:600;
white-space:nowrap;
}

.subscribe-discount{
color:#39c6c6;
font-weight:700;
}

.subscribe-option{
border:2px dashed #39c6c6 !important;
background:#f8fffe;
}

.main-options .vip-option:has(input[type="radio"]:checked){
  border:2px solid #39c6c6 !important;
  background:#f8fffe;
  box-shadow: 0 0 0 2px rgba(57, 198, 198, 0.2);
}

.subscription-option .vip-option:has(input[type="checkbox"]:checked) .subscribe-discount{
  color:#fff;
}

/* Enhanced visual feedback for combinations */
.vip-purchase-options.with-subscription .subscribe-option {
  animation: pulse 2s infinite;
}

/* VIP member — discounted price on Buy one time */
.vip-member-badge {
  display: inline-block;
  background: gold;
  color: #000;
  font-size: 11px;
  font-weight: 700;
  padding: 2px 7px;
  border-radius: 4px;
  margin-left: 8px;
  vertical-align: middle;
  letter-spacing: 0.3px;
}

.vip-active-option {
  border: 2px solid gold !important;
  background: #fffdf0;
}

.vip-original-price {
  text-decoration: line-through;
  opacity: 0.5;
  font-weight: 400;
  margin-right: 6px;
  font-size: 13px;
}

.vip-discounted-price {
  color: #c8860a;
  font-weight: 700;
  font-size: 16px;
}



@keyframes pulse {
  0% { box-shadow: 0 0 0 2px rgba(57, 198, 198, 0.4); }
  50% { box-shadow: 0 0 0 4px rgba(57, 198, 198, 0.2); }
  100% { box-shadow: 0 0 0 2px rgba(57, 198, 198, 0.4); }
}

/* Hide Shopify native purchase options */
.shopify-payment-terms,
.product-form__input input[name="selling_plan"],
.product-form__input input[name="selling_plan"] + label,
.product-form__selling-plan-group,
.product__selling-plan-group,
[data-product-purchase-options],
[data-selling-plan-group]{
  opacity: 0;
  pointer-events: none;
  height: 0;
  overflow: hidden;
}

</style>



<script>
document.addEventListener("DOMContentLoaded", function(){

  /* -----------------------------
     GET VIP STATUS FROM METAFIELD
  ----------------------------- */
  const IS_VIP = {{ customer.metafields.vip.is_vip.value | json }};
  const vipActive = IS_VIP === true || IS_VIP === "true";

  console.log("[VIP DEBUG] VIP STATUS:", vipActive);

  /* -----------------------------
     HIDE DEFAULT PRICE
  ----------------------------- */
  const price = document.querySelector('.price--large');

  if(price){
    const priceWrapper = price.closest('.price');
    if(priceWrapper){
      priceWrapper.style.display = "none";
    }
  }

  /* -----------------------------
     SELECTORS
  ----------------------------- */
  const purchaseTypeRadios = document.querySelectorAll('input[name="purchase_type"]');
  const subscribeCheckbox = document.querySelector('input[name="purchase_option"][value="subscribe"]');

  const productForm = document.querySelector('form[action^="/cart/add"]');

  if(!productForm){
    console.warn("[VIP DEBUG] Product form not found");
    return;
  }

  const regularRadio = document.querySelector('input[value="regular"]');
    if (regularRadio) {
      regularRadio.checked = true;
    }



  /* -----------------------------
     SUBSCRIPTION SETUP
  ----------------------------- */
  const subscribePlanId = "{{ subscribe_plan | split: '/' | last }}";
  console.log("[VIP DEBUG] Subscribe plan:", subscribePlanId);

  let sellingPlanInput = productForm.querySelector('[name="selling_plan"]');

  if(!subscribePlanId){
    const subscribeOption = document.querySelector('.subscription-option');
    if(subscribeOption){
      subscribeOption.remove();
    }
  }

  if(!sellingPlanInput){
    sellingPlanInput = document.createElement("input");
    sellingPlanInput.type = "hidden";
    sellingPlanInput.name = "selling_plan";
    productForm.appendChild(sellingPlanInput);

    console.log("[VIP DEBUG] Created selling_plan input");
  }

  /* -----------------------------
     VISUAL + STATE HANDLER
  ----------------------------- */
  function updateVisualFeedback() {

  const optionsContainer = document.querySelector('.vip-purchase-options');
  if (!optionsContainer) return;

  optionsContainer.classList.remove('with-subscription', 'regular-selected', 'vip-selected');

  // ✅ safer selection
  const selectedRadio = Array.from(document.querySelectorAll('input[name="purchase_type"]'))
    .find(r => r.checked);

  const selectedType = selectedRadio ? selectedRadio.value : "regular";

  console.log("[VIP DEBUG] selectedType:", selectedType);

  // ✅ ALWAYS reset first
  if (sellingPlanInput) {
    sellingPlanInput.value = "";
  }

  if (selectedType === 'regular') {
    optionsContainer.classList.add('regular-selected');
  } else if (selectedType === 'vip') {
    optionsContainer.classList.add('vip-selected');
  }

  // 🚫 VIP → no subscription ever
  if (selectedType === "vip") {
    console.log("[VIP DEBUG] VIP → force no subscription");
    return;
  }

  // ✅ Only if checkbox checked
  if (subscribeCheckbox?.checked && subscribePlanId) {
    sellingPlanInput.value = subscribePlanId;
    console.log("[VIP DEBUG] Subscription enabled:", subscribePlanId);
  } else {
    console.log("[VIP DEBUG] Subscription disabled");
  }
}

  /* -----------------------------
   SAFE LOADER (SUBMIT BASED)
  ----------------------------- */

  document.addEventListener("submit", function (e) {

    const form = e.target;

    const isCartForm =
      form.matches('form[action*="/cart/add"]') ||
      form.classList.contains('product-form');

    if (!isCartForm) return;

    const btn = form.querySelector(
      'button[type="submit"], button[name="add"], .product-form__submit'
    );

    if (!btn) return;

    if (btn.dataset.loading === "true") return;

    // mark loading
    btn.dataset.loading = "true";

    // store original text
    btn.dataset.originalText = btn.innerText;

    const span = btn.querySelector("span");

    if (span) {
      span.innerText = "Adding to cart...";
    } else {
      btn.innerText = "Adding to cart...";
    }

  }, true);
  /* -----------------------------
     EVENT LISTENERS
  ----------------------------- */
  purchaseTypeRadios.forEach(radio => {
    radio.addEventListener('change', updateVisualFeedback);
  });

  if(subscribeCheckbox){
    subscribeCheckbox.addEventListener('change', updateVisualFeedback);
  }

  /* -----------------------------
     INITIAL STATE
  ----------------------------- */
  updateVisualFeedback();

});
</script>



{% endif %}

{% schema %}
{
"name": "VIP Purchase Options",
"target": "section",
"templates": ["product"]
}
{% endschema %}